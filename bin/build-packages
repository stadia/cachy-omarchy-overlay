#!/usr/bin/env bash
# Build and audit both packages without installing them (SPEC §27, §33).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
state_dir=${COO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cachy-omarchy}
makepkg_bin=${COO_MAKEPKG_BIN:-makepkg}
bsdtar_bin=${COO_BSDTAR_BIN:-bsdtar}
sha256_bin=${COO_SHA256_BIN:-sha256sum}
install_bin=${COO_INSTALL_BIN:-install}
mv_bin=${COO_MV_BIN:-mv}
lock=$repo_root/upstream.lock
shell_pkg=$repo_root/packages/cachy-omarchy-shell/PKGBUILD
overlay_pkg=$repo_root/packages/cachy-omarchy-overlay/PKGBUILD

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
[[ -f $lock && -f $shell_pkg && -f $overlay_pkg ]] || fail 'repository package metadata is incomplete'
# shellcheck disable=SC1090
source "$lock"
[[ $OMARCHY_VERSION =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $OMARCHY_COMMIT =~ ^[0-9a-fA-F]{40}$ ]] || fail 'invalid upstream.lock'

pkg_field() { grep -m1 -E "^$2=" "$1" | cut -d= -f2- | tr -d "'\""; }
shell_rel=$(pkg_field "$shell_pkg" pkgrel)
overlay_ver=$(pkg_field "$overlay_pkg" pkgver)
overlay_rel=$(pkg_field "$overlay_pkg" pkgrel)
[[ $shell_rel =~ ^[0-9]+$ && $overlay_ver =~ ^[0-9]+\.[0-9]+\.[0-9]+$ && $overlay_rel =~ ^[0-9]+$ ]] || fail 'invalid PKGBUILD version metadata'

work=$(mktemp -d "${TMPDIR:-/tmp}/coo-build-XXXXXX")
mkdir -p "$build_dir" "$state_dir/validated-builds"
# Candidate release lives under state so the final candidate→release rename is
# same-filesystem. The flat build dir is convenience only, never validation.
stage=$(mktemp -d "$state_dir/validated-builds/.candidate-XXXXXX")
trap 'rm -rf "$work" "$stage"' EXIT
pkgdest=$work/pkgdest
mkdir -p "$pkgdest" "$stage/artifacts"

run_makepkg() {
  local dir=$1
  ( cd "$dir"
    PKGDEST="$pkgdest" COO_OMARCHY_GIT="${COO_OMARCHY_GIT:-$repo_root/build/omarchy}" \
      "$makepkg_bin" --nodeps
  )
}
run_makepkg "$repo_root/packages/cachy-omarchy-shell"
run_makepkg "$repo_root/packages/cachy-omarchy-overlay"

shell_name="cachy-omarchy-shell-${OMARCHY_VERSION}-${shell_rel}-any.pkg.tar.zst"
overlay_name="cachy-omarchy-overlay-${overlay_ver}-${overlay_rel}-any.pkg.tar.zst"
for name in "$shell_name" "$overlay_name"; do
  [[ -f $pkgdest/$name ]] || fail "expected artifact missing: $name"
done
[[ $(find "$pkgdest" -maxdepth 1 -type f -name '*.pkg.tar.zst' | wc -l) -eq 2 ]] || fail 'ambiguous build artifacts'

audit() {
  local archive=$1 listing
  listing=$($bsdtar_bin -tf "$archive") || return 1
  if grep -Eq '(^|/)(etc|boot|efi)(/|$)|usr/lib/systemd/system/' <<<"$listing"; then
    return 1
  fi
}
audit "$pkgdest/$shell_name" || fail "archive audit failed: $shell_name"
audit "$pkgdest/$overlay_name" || fail "archive audit failed: $overlay_name"

# Stage exact copies and checksums in an unreferenced candidate release.
for name in "$shell_name" "$overlay_name"; do
  "$install_bin" -m 644 "$pkgdest/$name" "$stage/artifacts/$name"
done
release_name="release-${OMARCHY_VERSION}-${OMARCHY_COMMIT:0:12}-${stage##*/.candidate-}"
release_rel="validated-builds/$release_name"
manifest_tmp=$stage/validated-build.manifest
{
  printf 'RELEASE=%s\n' "$release_rel"
  printf 'OMARCHY_VERSION=%s\n' "$OMARCHY_VERSION"
  printf 'OMARCHY_COMMIT=%s\n' "$OMARCHY_COMMIT"
  for name in "$shell_name" "$overlay_name"; do
    sum=$($sha256_bin "$stage/artifacts/$name" | awk '{print $1}')
    [[ $sum =~ ^[0-9a-fA-F]{64}$ ]] || exit 1
    printf 'ARTIFACT=%s %s\n' "$name" "$sum"
  done
} >"$manifest_tmp"

# Freeze a complete immutable-by-contract release before convenience
# publication. This pipeline never mutates a release after this rename.
release_dir="$state_dir/$release_rel"
"$mv_bin" "$stage" "$release_dir"
stage=""

# Flat build artifacts are convenience copies only. A failure here leaves the
# previous pointer unchanged and the immutable new release unreferenced.
for name in "$shell_name" "$overlay_name"; do
  "$install_bin" -m 644 "$release_dir/artifacts/$name" "$build_dir/$name"
done

# This atomic same-directory rename is the sole validation commit point.
pointer_tmp=$(mktemp "$state_dir/.validated-build.manifest-XXXXXX")
cp "$release_dir/validated-build.manifest" "$pointer_tmp"
"$mv_bin" "$pointer_tmp" "$state_dir/validated-build.manifest"
printf 'validated build: %s\n' "$state_dir/validated-build.manifest"
