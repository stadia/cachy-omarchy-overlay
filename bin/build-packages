#!/usr/bin/env bash
# Build and audit both packages into build/ without installing them (SPEC §27).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
makepkg_bin=${COO_MAKEPKG_BIN:-makepkg}
bsdtar_bin=${COO_BSDTAR_BIN:-bsdtar}
install_bin=${COO_INSTALL_BIN:-install}

usage() {
  cat <<'USAGE'
Usage: build-packages

Build shell and overlay packages into build/ without installing them.
This command never passes makepkg -i.
USAGE
}

while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
# shellcheck disable=SC1091
source "$repo_root/bin/package-names.sh"
coo_current_artifacts "$repo_root" || exit 1

work=$(mktemp -d "${TMPDIR:-/tmp}/coo-build-XXXXXX")
trap 'rm -rf "$work"' EXIT
pkgdest=$work/pkgdest
mkdir -p "$pkgdest"

run_makepkg() {
  ( cd "$1"
    PKGDEST="$pkgdest" COO_OMARCHY_GIT="${COO_OMARCHY_GIT:-$repo_root/build/omarchy}" \
      "$makepkg_bin" --nodeps
  )
}
run_makepkg "$repo_root/packages/cachy-omarchy-shell"
run_makepkg "$repo_root/packages/cachy-omarchy-overlay"

for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  [[ -f $pkgdest/$name ]] || fail "expected artifact missing: $name"
done
[[ $(find "$pkgdest" -maxdepth 1 -type f -name '*.pkg.tar.zst' | wc -l) -eq 2 ]] || fail 'ambiguous build artifacts'

audit() {
  local listing
  listing=$("$bsdtar_bin" -tf "$1") || return 1
  local status=0
  grep -Eq '(^|/)(etc|boot|efi)(/|$)|usr/lib/systemd/system/' <<<"$listing" || status=$?
  # 1 = no forbidden path; 0 = found one; anything else = grep itself broke.
  (( status == 1 ))
}
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  audit "$pkgdest/$name" || fail "archive audit failed: $name"
done

# Nothing reaches build/ under a current name until both packages built,
# passed the audit and were fully copied: copy each to a hidden temp name in
# build/ (same filesystem), then rename both into place. Older versions stay
# there: bin/rollback installs from them. The two renames are not atomic
# together: if the second fails, build/ can hold a new shell beside an old
# overlay of the same version that were never verified as a pair.
mkdir -p "$build_dir"
staged=()
trap 'rm -rf "$work"; rm -f "${staged[@]}"' EXIT
# mktemp gives each invocation its own temp name, so overlapping builds cannot
# rename or remove each other's half-copied file.
declare -A tmp_of
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  tmp_of[$name]=$(mktemp "$build_dir/.$name.XXXXXX") || fail "could not create a temp file in $build_dir"
  staged+=("${tmp_of[$name]}")
  "$install_bin" -m 644 "$pkgdest/$name" "${tmp_of[$name]}" || fail "could not copy $name into $build_dir"
done
# Serialize the final renames: two publishers of the same names must not
# interleave into a shell from one build beside an overlay from another.
exec {publish_lock}>"$build_dir/.publish.lock" || fail "could not open $build_dir/.publish.lock"
flock -w 60 "$publish_lock" || fail "timed out waiting for another publisher of $build_dir"
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  mv -f "${tmp_of[$name]}" "$build_dir/$name" ||
    fail "partial publish: $name not renamed; build/ may hold a mixed pair, rerun bin/build-packages"
  printf 'built: %s\n' "$build_dir/$name"
done
