#!/usr/bin/env bash
# Build and audit both packages into build/ without installing them (SPEC §27).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
makepkg_bin=${COO_MAKEPKG_BIN:-makepkg}
bsdtar_bin=${COO_BSDTAR_BIN:-bsdtar}
install_bin=${COO_INSTALL_BIN:-install}

usage() {
  cat <<'USAGE'
Usage: build-packages

Build shell and overlay packages into build/ without installing them.
This command never passes makepkg -i.
USAGE
}

while (($#)); do
  case $1 in
    -h|--help) usage; exit 0 ;;
    *) printf 'error: unknown argument: %s\n' "$1" >&2; usage >&2; exit 2 ;;
  esac
  shift
done

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
# shellcheck disable=SC1091
source "$repo_root/bin/package-names.sh"
coo_current_artifacts "$repo_root" || exit 1

work=$(mktemp -d "${TMPDIR:-/tmp}/coo-build-XXXXXX")
trap 'rm -rf "$work"' EXIT
pkgdest=$work/pkgdest
mkdir -p "$pkgdest"

run_makepkg() {
  ( cd "$1"
    PKGDEST="$pkgdest" COO_OMARCHY_GIT="${COO_OMARCHY_GIT:-$repo_root/build/omarchy}" \
      "$makepkg_bin" --nodeps
  )
}
run_makepkg "$repo_root/packages/cachy-omarchy-shell"
run_makepkg "$repo_root/packages/cachy-omarchy-overlay"

for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  [[ -f $pkgdest/$name ]] || fail "expected artifact missing: $name"
done
[[ $(find "$pkgdest" -maxdepth 1 -type f -name '*.pkg.tar.zst' | wc -l) -eq 2 ]] || fail 'ambiguous build artifacts'

audit() {
  local listing
  listing=$("$bsdtar_bin" -tf "$1") || return 1
  ! grep -Eq '(^|/)(etc|boot|efi)(/|$)|usr/lib/systemd/system/' <<<"$listing"
}
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  audit "$pkgdest/$name" || fail "archive audit failed: $name"
done

# Nothing reaches build/ under a current name until both packages built,
# passed the audit and were fully copied: copy each to a hidden temp name in
# build/ (same filesystem), then rename both into place. Older versions stay
# there: bin/rollback installs from them.
mkdir -p "$build_dir"
staged=()
trap 'rm -rf "$work"; rm -f "${staged[@]}"' EXIT
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  staged+=("$build_dir/.$name.tmp")
  "$install_bin" -m 644 "$pkgdest/$name" "$build_dir/.$name.tmp" || fail "could not copy $name into $build_dir"
done
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  mv -f "$build_dir/.$name.tmp" "$build_dir/$name"
  printf 'built: %s\n' "$build_dir/$name"
done
