#!/usr/bin/env bash
# Explicitly install only the current checksum-validated pair (SPEC §33).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
state_dir=${COO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cachy-omarchy}
sha256_bin=${COO_SHA256_BIN:-sha256sum}
install_bin=${COO_INSTALL_BIN:-install}
mv_bin=${COO_MV_BIN:-mv}
pacman_bin=${COO_PACMAN_BIN:-pacman}
# shellcheck disable=SC1091
source "$repo_root/bin/validated-build.sh"

usage() { printf 'Usage: install-packages --install\n'; }
[[ ${1:-} == --install && $# -eq 1 ]] || { usage >&2; exit 1; }

pending=$state_dir/install-pending.manifest
[[ ! -e $pending ]] || { coo_fail 'incomplete install state requires operator recovery'; exit 1; }
manifest=$state_dir/validated-build.manifest
coo_validate_current_manifest "$repo_root" "$state_dir" "$manifest" "$sha256_bin" || exit 1
current_release_dir=$COO_RELEASE_DIR
current_artifacts=("${COO_ARTIFACT_NAMES[@]}")

# Preserve the previously installed validated pair before any package manager
# invocation. A missing installed pointer simply means this is the first install.
installed=$state_dir/installed-build.manifest
if [[ -e $installed ]]; then
  coo_validate_manifest "$state_dir" "$installed" "$sha256_bin" || exit 1
  coo_archive_validated_release "$state_dir" "$installed" "$install_bin" "$sha256_bin" "$mv_bin" >/dev/null \
    || { coo_fail 'could not archive previous validated pair'; exit 1; }
fi

# Persist the exact intended pair before pacman. If finalization cannot write
# installed-build.manifest after a successful pacman transaction, this pending
# marker blocks both install and rollback instead of trusting stale state.
pending_tmp=$(mktemp "$state_dir/.install-pending.manifest-XXXXXX")
cp "$manifest" "$pending_tmp"
"$mv_bin" "$pending_tmp" "$pending"

set +e
"$pacman_bin" -U "$current_release_dir/artifacts/${current_artifacts[0]}" \
  "$current_release_dir/artifacts/${current_artifacts[1]}"
status=$?
set -e
if (( status != 0 )); then
  rm -f "$pending"
  exit "$status"
fi

pointer_tmp=$(mktemp "$state_dir/.installed-build.manifest-XXXXXX")
cp "$manifest" "$pointer_tmp"
set +e
COO_INSTALL_FINALIZE=1 "$mv_bin" "$pointer_tmp" "$installed"
status=$?
set -e
if (( status != 0 )); then
  coo_fail 'pacman succeeded but installed state finalization failed; pending state retained' || :
  exit "$status"
fi
rm -f "$pending" || { coo_fail 'installed state finalized but pending marker could not be removed'; exit 1; }
printf 'installed validated build: %s\n' "$installed"
