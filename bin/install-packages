#!/usr/bin/env bash
# Install the current build/ pair with pacman -U (SPEC §37).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
pacman_bin=${COO_PACMAN_BIN:-}
sudo_bin=${COO_SUDO_BIN:-sudo}
fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
# shellcheck disable=SC1091
source "$repo_root/bin/package-names.sh"

# Elevate only the pacman transaction, never the whole script. COO_PACMAN_BIN
# overrides verbatim (tests substitute a fake pacman) and is never wrapped.
if [[ -n $pacman_bin ]]; then
  pacman_cmd=("$pacman_bin")
elif (( EUID == 0 )); then
  fail 'do not run install-packages with sudo; run it as your normal user — it elevates only the pacman transaction itself. Usage: ./bin/install-packages --install'
else
  pacman_cmd=("$sudo_bin" pacman)
fi

[[ ${1:-} == --install && $# -eq 1 ]] || { printf 'Usage: install-packages --install\n' >&2; exit 1; }

coo_current_artifacts "$repo_root" || exit 1
for name in "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"; do
  [[ -f $build_dir/$name ]] || fail "build artifact missing: $name (run bin/build-packages)"
done
"${pacman_cmd[@]}" -U "$build_dir/$COO_SHELL_ARTIFACT" "$build_dir/$COO_OVERLAY_ARTIFACT"
printf 'installed: %s %s\n' "$COO_SHELL_ARTIFACT" "$COO_OVERLAY_ARTIFACT"
