#!/usr/bin/env bash
# Prepare and validate a new upstream pin without installing it (SPEC §31–33).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
git_bin=${COO_GIT_BIN:-git}
mv_bin=${COO_MV_BIN:-mv}
install_bin=${COO_INSTALL_BIN:-install}
state_dir=${COO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cachy-omarchy}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
lock=$repo_root/upstream.lock
shell_pkg=$repo_root/packages/cachy-omarchy-shell/PKGBUILD

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
usage() { printf 'Usage: update-upstream\n'; }
case ${1:-} in
  --help) usage; exit 0 ;;
  '') ;;
  *) usage >&2; exit 1 ;;
esac
[[ -f $lock && -f $shell_pkg ]] || fail 'repository update metadata is incomplete'
# shellcheck disable=SC1090
source "$lock"

# Match check-upstream: annotated tags use peeled commits; lightweight tags use
# the direct ref. Only stable vMAJOR.MINOR.PATCH tags are candidates.
refs=$($git_bin ls-remote --tags "$OMARCHY_REPOSITORY") || fail 'unable to query upstream tags'
latest=$(awk '$2 ~ /^refs\/tags\/v[0-9]+\.[0-9]+\.[0-9]+$/ { sub("refs/tags/v", "", $2); print $2 }' <<<"$refs" | sort -V | tail -n1)
[[ -n $latest ]] || fail 'no stable semver tags found'
tag_ref="refs/tags/v$latest"
peeled=$(awk -v tag="${tag_ref}^{}" '$2 == tag { print $1; exit }' <<<"$refs")
direct=$(awk -v tag="$tag_ref" '$2 == tag { print $1; exit }' <<<"$refs")
commit=${peeled:-$direct}
[[ $commit =~ ^[0-9a-fA-F]{40}$ ]] || fail "invalid commit for v$latest"
if [[ $latest == "$OMARCHY_VERSION" && $commit == "$OMARCHY_COMMIT" ]]; then
  printf 'up to date: Omarchy %s %s\n' "$OMARCHY_VERSION" "$OMARCHY_COMMIT"
  exit 0
fi

candidate=$(mktemp -d "${TMPDIR:-/tmp}/coo-update-XXXXXX")
trap 'rm -rf "$candidate"' EXIT
# Copy every tracked runtime/test input needed by the default test runner while
# deliberately pruning ignored makepkg leftovers (packages/*/{pkg,src} and the
# shell package's git VCS clone, whose frozen file:// origin points at the old
# $COO_OMARCHY_GIT and makes the candidate's makepkg reject its own source).
copy_tree() {
  local item=$1 path relative
  [[ -e $repo_root/$item ]] || return 0
  while IFS= read -r -d '' path; do
    relative=${path#"$repo_root/"}
    mkdir -p "$candidate/$(dirname "$relative")"
    cp -a "$path" "$candidate/$relative"
  done < <(find "$repo_root/$item" \( -path '*/pkg' -o -path '*/src' -o -path '*/packages/cachy-omarchy-shell/omarchy' \) -prune -o -type f -print0)
}
for item in bin packages overlay tests lib docs; do
  copy_tree "$item"
done
for item in upstream.lock UPSTREAM.md SPEC.md README.md README.ko-KR.md; do
  [[ -f $repo_root/$item ]] && cp -a "$repo_root/$item" "$candidate/$item"
done
mkdir -p "$candidate/build"
# Some source tests use git ls-files. This is a disposable candidate index,
# never a worktree or mutation of the caller's repository.
git init -q "$candidate"
git -C "$candidate" add -A

candidate_lock=$candidate/upstream.lock
candidate_pkg=$candidate/packages/cachy-omarchy-shell/PKGBUILD
cat >"$candidate_lock" <<EOF
OMARCHY_VERSION=$latest
OMARCHY_COMMIT=$commit
OMARCHY_CHANNEL=$OMARCHY_CHANNEL
OMARCHY_REPOSITORY=$OMARCHY_REPOSITORY
OMARCHY_TAG=v$latest
EOF
pkg_tmp=$(mktemp "${candidate_pkg%/*}/.PKGBUILD-update-XXXXXX")
awk -v version="$latest" -v pin="$commit" '
  /^pkgver=/ { print "pkgver=" version; next }
  /^pkgrel=/ { print "pkgrel=1"; next }
  /^_commit=/ { print "_commit=\047" pin "\047"; next }
  { print }
' "$candidate_pkg" >"$pkg_tmp"
"$mv_bin" "$pkg_tmp" "$candidate_pkg"

# Fetch the selected new pin into the disposable candidate before applying
# maintained runtime patches. COO_OMARCHY_GIT may still name an older local
# checkout while an update is available, so never copy it here. Both candidate
# package building and tests must receive the newly selected commit.
candidate_source=$candidate/upstream
if ! "$git_bin" init -q "$candidate_source" ||
   ! "$git_bin" -C "$candidate_source" fetch -q --depth 1 "$OMARCHY_REPOSITORY" "$commit" 2>/dev/null ||
   ! git -C "$candidate_source" cat-file -e "$commit^{commit}" 2>/dev/null ||
   ! git -C "$candidate_source" checkout -q --detach "$commit"; then
  fail "could not fetch selected upstream source for $commit"
fi
candidate_head=$(git -C "$candidate_source" rev-parse --verify 'HEAD^{commit}') || fail 'could not read candidate upstream source HEAD'
[[ $candidate_head == "$commit" ]] || fail "candidate upstream source is not selected commit: $candidate_head"

if [[ ${COO_PATCH_FAIL:-0} == 1 ]]; then
  fail 'patch application failed'
fi
patch_bin=${COO_PATCH_APPLY_BIN:-git}
while IFS= read -r -d '' patch; do
  "$patch_bin" -C "$candidate_source" apply "$patch" || fail "patch application failed: ${patch##*/}"
done < <(find "$repo_root/packages" -path '*/patches/*.patch' -type f -print0 | sort -z)

# The candidate's package and test contracts must retain the maintained patches
# used to construct its disposable source, but copying untracked files would
# pull in ignored makepkg artifacts. Copy only the README and patch inputs.
patches_source=$repo_root/packages/cachy-omarchy-shell/patches
patches_candidate=$candidate/packages/cachy-omarchy-shell/patches
mkdir -p "$patches_candidate"
cp -a "$patches_source/README.md" "$patches_candidate/README.md"
while IFS= read -r -d '' patch; do
  cp -a "$patch" "$patches_candidate/${patch##*/}"
done < <(find "$patches_source" -name '*.patch' -type f -print0 | sort -z)

# Source-tree tests copied by update-upstream read only tracked files. Stage the
# explicit patch contract in the candidate index so the nested test runner sees
# the same inputs that were applied to its disposable source.
git -C "$candidate" add packages/cachy-omarchy-shell/patches

# The nested package-file test reads COO_OMARCHY_GIT and applies the maintained
# patches itself. It must start from the pristine selected pin, while package
# builds above deliberately use the patched candidate_source.
candidate_test_source=$candidate/upstream-pristine
if ! "$git_bin" init -q "$candidate_test_source" ||
   ! "$git_bin" -C "$candidate_test_source" fetch -q --depth 1 "$OMARCHY_REPOSITORY" "$commit" 2>/dev/null ||
   ! git -C "$candidate_test_source" cat-file -e "$commit^{commit}" 2>/dev/null ||
   ! git -C "$candidate_test_source" checkout -q --detach "$commit"; then
  fail 'could not prepare pristine candidate source for tests'
fi
candidate_test_head=$(git -C "$candidate_test_source" rev-parse --verify 'HEAD^{commit}') || fail 'could not read pristine candidate source HEAD'
[[ $candidate_test_head == "$commit" ]] || fail "pristine candidate source is not selected commit: $candidate_test_head"

# tests/data/upstream-helpers.txt and upstream.lock's OMARCHY_COMMIT are one
# fact in two files: the inventory is the closure scanner's ground truth for
# "is this really an upstream helper", scoped to the exact commit named
# above. tests/runtime/test_upstream_helper_inventory.sh enforces that they
# agree, unconditionally -- including inside the candidate's own nested test
# run below, which is what first catches a stale inventory. So the pin and
# the inventory move together, here, before that nested run sees either one.
#
# The new commit's tree, not whatever build/omarchy happens to have checked
# out: the pin just moved, and nothing yet guarantees a local checkout at
# this exact commit exists. A disposable shallow fetch (through $git_bin, so
# it is mockable exactly like the ls-remote call above) is the only source
# that is guaranteed current.
inventory=$repo_root/tests/data/upstream-helpers.txt
candidate_inventory=$candidate/tests/data/upstream-helpers.txt
inventory_clone=$(mktemp -d "${TMPDIR:-/tmp}/coo-update-inventory-XXXXXX")
inventory_names=""
# $git_bin (mockable) does the network fetch; the object-existence check and
# ls-tree below deliberately use the real system git, not $git_bin, to read
# back what actually landed in $inventory_clone/.git. A tool override that
# reports success without doing real work (as this repo's own test fixtures
# do for $git_bin ls-remote) still leaves no such commit object on disk, so
# `cat-file -e` genuinely fails instead of trusting a fake "success" -- the
# one thing this step must never do is publish a bin/ list that was not
# actually read from the pinned commit's tree.
if "$git_bin" init -q "$inventory_clone" &&
   "$git_bin" -C "$inventory_clone" fetch -q --depth 1 "$OMARCHY_REPOSITORY" "$commit" 2>/dev/null &&
   git -C "$inventory_clone" cat-file -e "$commit^{commit}" 2>/dev/null &&
   inventory_tree=$(git -C "$inventory_clone" ls-tree --name-only "$commit" -- bin/ 2>/dev/null); then
  inventory_names=$(sed 's|^bin/||' <<<"$inventory_tree" | LC_ALL=C sort)
fi
rm -rf "$inventory_clone"
[[ -n $inventory_names ]] || fail "could not fetch upstream bin/ tree for $commit to regenerate tests/data/upstream-helpers.txt"
inventory_short=${commit:0:12}
{
  awk -v commit="$commit" -v short="$inventory_short" '
    /^# commit: / { print "# commit: " commit; next }
    /^# regenerate: / { print "# regenerate: git -C build/omarchy ls-tree --name-only " short " bin/ | sed \"s|^bin/||\" | LC_ALL=C sort"; next }
    /^#/ { print; next }
    { exit }
  ' "$inventory"
  printf '%s\n' "$inventory_names"
} >"$candidate_inventory.new"
"$mv_bin" "$candidate_inventory.new" "$candidate_inventory"

# Candidate commands see only candidate metadata. Tool overrides are inherited
# deliberately so U06–U08 can use fake makepkg/audit/test tools without network.
candidate_state=$candidate/state
candidate_build=$candidate/build
COO_REPO_ROOT="$candidate" COO_BUILD_DIR="$candidate_build" COO_STATE_DIR="$candidate_state" \
  COO_OMARCHY_GIT="$candidate_source" \
  "$candidate/bin/build-packages"
COO_REPO_ROOT="$candidate" COO_STATE_DIR="$candidate_state" \
  COO_OMARCHY_GIT="$candidate_test_source" \
  "$candidate/bin/test-packages"

candidate_manifest=$candidate_state/validated-build.manifest
[[ -f $candidate_manifest ]] || fail 'candidate validation manifest missing'
release_rel=$(awk -F= '$1 == "RELEASE" { print $2; exit }' "$candidate_manifest")
[[ $release_rel == validated-builds/* && -d $candidate_state/$release_rel ]] || fail 'candidate release missing'

# Publish candidate artifacts/state first. The existing manifest remains the
# authority until the final pointer rename below; stray flat archives are never
# treated as validated by M6 commands.
mkdir -p "$state_dir/validated-builds" "$build_dir"
release_target=$state_dir/$release_rel
[[ ! -e $release_target ]] || fail 'candidate release already exists'
"$mv_bin" "$candidate_state/$release_rel" "$release_target"
while IFS= read -r artifact; do
  name=${artifact##*/}
  "$install_bin" -m 644 "$artifact" "$build_dir/$name"
done < <(find "$release_target/artifacts" -maxdepth 1 -type f -name '*.pkg.tar.zst' -print | sort)
# POSIX cannot atomically rename two different tracked files. Prepare both in
# their own directories, then compensate the first rename if the second or the
# final manifest commit fails. The old manifest remains authoritative until
# both tracked metadata files have published.
pointer_tmp=$(mktemp "$state_dir/.validated-build.manifest-update-XXXXXX")
cp "$candidate_manifest" "$pointer_tmp"
lock_backup=$(mktemp "${lock%/*}/.upstream.lock-backup-XXXXXX")
pkg_backup=$(mktemp "${shell_pkg%/*}/.PKGBUILD-backup-XXXXXX")
inventory_backup=$(mktemp "${inventory%/*}/.upstream-helpers-backup-XXXXXX")
lock_new=$(mktemp "${lock%/*}/.upstream.lock-new-XXXXXX")
pkg_new=$(mktemp "${shell_pkg%/*}/.PKGBUILD-new-XXXXXX")
inventory_new=$(mktemp "${inventory%/*}/.upstream-helpers-new-XXXXXX")
cp "$lock" "$lock_backup"; cp "$shell_pkg" "$pkg_backup"; cp "$inventory" "$inventory_backup"
cp "$candidate_lock" "$lock_new"; cp "$candidate_pkg" "$pkg_new"; cp "$candidate_inventory" "$inventory_new"
if ! COO_UPDATE_METADATA_PUBLISH=lock "$mv_bin" "$lock_new" "$lock"; then
  fail 'could not publish upstream.lock'
fi
if ! COO_UPDATE_METADATA_PUBLISH=pkg "$mv_bin" "$pkg_new" "$shell_pkg"; then
  "$mv_bin" "$lock_backup" "$lock" || fail 'could not restore upstream.lock after PKGBUILD failure'
  fail 'could not publish shell PKGBUILD; upstream.lock restored'
fi
if ! COO_UPDATE_METADATA_PUBLISH=inventory "$mv_bin" "$inventory_new" "$inventory"; then
  "$mv_bin" "$pkg_backup" "$shell_pkg" || fail 'could not restore shell PKGBUILD after inventory failure'
  "$mv_bin" "$lock_backup" "$lock" || fail 'could not restore upstream.lock after inventory failure'
  fail 'could not publish upstream-helpers.txt inventory; PKGBUILD and upstream.lock restored'
fi
if ! "$mv_bin" "$pointer_tmp" "$state_dir/validated-build.manifest"; then
  "$mv_bin" "$inventory_backup" "$inventory" || fail 'could not restore upstream-helpers.txt after manifest failure'
  "$mv_bin" "$pkg_backup" "$shell_pkg" || fail 'could not restore shell PKGBUILD after manifest failure'
  "$mv_bin" "$lock_backup" "$lock" || fail 'could not restore upstream.lock after manifest failure'
  fail 'could not publish validated manifest; metadata restored'
fi
rm -f "$lock_backup" "$pkg_backup" "$inventory_backup"

# UPSTREAM.md includes a human-tested environment and release date. Those facts
# cannot be inferred from a git tag, so this command deliberately leaves it
# unchanged and states that the machine authority is upstream.lock.
printf 'ready: Omarchy %s %s (UPSTREAM.md requires human release/test attestation)\n' "$latest" "$commit"
