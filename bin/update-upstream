#!/usr/bin/env bash
# Move the upstream pin in this repository, build it, test it, and keep the
# result only if everything passes (SPEC §31–33). Nothing is installed.
#
#   fetch the new tag into build/omarchy -> rewrite upstream.lock and the shell
#   PKGBUILD -> drop makepkg's stale caches -> build -> run the full suite.
#
# On any failure the tracked files are restored with git and build/omarchy goes
# back to the old pin; --keep leaves the failed state in place for debugging.
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
git_bin=${COO_GIT_BIN:-git}
omarchy_git=${COO_OMARCHY_GIT:-$repo_root/build/omarchy}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
lock=$repo_root/upstream.lock
shell_dir=$repo_root/packages/cachy-omarchy-shell
shell_pkg=$shell_dir/PKGBUILD
tracked=(upstream.lock packages/cachy-omarchy-shell/PKGBUILD)

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
usage() { printf 'Usage: update-upstream [--keep]\n'; }
keep=0
case ${1:-} in
  --help) usage; exit 0 ;;
  --keep) keep=1 ;;
  '') ;;
  *) usage >&2; exit 1 ;;
esac
[[ -f $lock && -f $shell_pkg ]] || fail 'repository update metadata is incomplete'
# shellcheck disable=SC1090
source "$lock"
# shellcheck disable=SC1091
source "$repo_root/bin/upstream-tag.sh"
# shellcheck disable=SC1091
source "$repo_root/bin/package-names.sh"

coo_latest_upstream_tag "$git_bin" "$OMARCHY_REPOSITORY" || exit 1
latest=$COO_LATEST_VERSION
commit=$COO_LATEST_COMMIT
if [[ $latest == "$OMARCHY_VERSION" && $commit == "$OMARCHY_COMMIT" ]]; then
  printf 'up to date: Omarchy %s %s\n' "$OMARCHY_VERSION" "$OMARCHY_COMMIT"
  exit 0
fi

# Failure restores these files from HEAD, so they must not carry local edits.
git -C "$repo_root" rev-parse --git-dir >/dev/null 2>&1 || fail 'update-upstream needs a git checkout'
git -C "$repo_root" diff --quiet HEAD -- "${tracked[@]}" ||
  fail "uncommitted changes in ${tracked[*]}; commit or stash them first"

old_shell_artifact=""
coo_current_artifacts "$repo_root" && old_shell_artifact=$COO_SHELL_ARTIFACT
old_head=""
if [[ -d $omarchy_git/.git ]]; then
  old_head=$(git -C "$omarchy_git" rev-parse --verify 'HEAD^{commit}' 2>/dev/null) || old_head=""
fi

restore() {
  local status=$?
  trap - EXIT
  (( status == 0 )) && exit 0
  if (( keep )); then
    printf 'kept: failed update left in place (--keep); undo with: git checkout HEAD -- %s\n' "${tracked[*]}" >&2
    exit "$status"
  fi
  git -C "$repo_root" checkout -q HEAD -- "${tracked[@]}"
  if [[ -n $old_head ]]; then
    git -C "$omarchy_git" checkout -q --detach "$old_head" || printf 'warn: could not return %s to %s\n' "$omarchy_git" "$old_head" >&2
  fi
  if [[ -n ${new_shell_artifact:-} && $new_shell_artifact != "$old_shell_artifact" ]]; then
    rm -f "${build_dir:?}/$new_shell_artifact"
  fi
  rm -rf "$shell_dir"/{src,pkg,omarchy}
  printf 'reverted: upstream.lock and the PKGBUILD are back at HEAD\n' >&2
  exit "$status"
}
trap restore EXIT

# 1. The new pin's source, in the clone every build and test reads.
if [[ ! -d $omarchy_git/.git ]]; then
  "$git_bin" clone -q "$OMARCHY_REPOSITORY" "$omarchy_git" || fail "could not clone $OMARCHY_REPOSITORY into $omarchy_git"
fi
"$git_bin" -C "$omarchy_git" fetch -q origin "$commit" || fail "could not fetch $commit from $OMARCHY_REPOSITORY"
git -C "$omarchy_git" checkout -q --detach "$commit" || fail "could not check out $commit in $omarchy_git"
[[ $(git -C "$omarchy_git" rev-parse 'HEAD^{commit}') == "$commit" ]] || fail "$omarchy_git is not at $commit"

# 2. Metadata.
cat >"$lock" <<EOT
OMARCHY_VERSION=$latest
OMARCHY_COMMIT=$commit
OMARCHY_CHANNEL=$OMARCHY_CHANNEL
OMARCHY_REPOSITORY=$OMARCHY_REPOSITORY
OMARCHY_TAG=v$latest
EOT
awk -v version="$latest" -v pin="$commit" '
  /^pkgver=/ { print "pkgver=" version; next }
  /^pkgrel=/ { print "pkgrel=1"; next }
  /^_commit=/ { print "_commit=\047" pin "\047"; next }
  { print }
' "$shell_pkg" >"$shell_pkg.new"
cat "$shell_pkg.new" >"$shell_pkg"
rm -f "$shell_pkg.new"
coo_current_artifacts "$repo_root" || exit 1
new_shell_artifact=$COO_SHELL_ARTIFACT

# 3. makepkg caches still hold the old tree.
rm -rf "$shell_dir"/{src,pkg,omarchy}

# 4. Build, test.
COO_REPO_ROOT=$repo_root COO_OMARCHY_GIT=$omarchy_git "$repo_root/bin/build-packages"
COO_REPO_ROOT=$repo_root COO_OMARCHY_GIT=$omarchy_git "$repo_root/bin/test-packages"

printf 'ready: Omarchy %s %s (review git diff; UPSTREAM.md requires human release/test attestation)\n' "$latest" "$commit"
