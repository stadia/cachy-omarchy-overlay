#!/usr/bin/env bash
# 깨끗한 시스템에서 PKGBUILD 의 depends 선언이 충분한지 증명한다.
#
# 기존 clean build(bin/build-packages --clean)는 의존 검사를 건너뛰므로
# 이 스크립트가 실제 pacman 트랜잭션으로 그 구멍을 메운다.
set -uo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
local_repo=${COO_LOCAL_REPO:-/tmp/coo-localrepo}

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
ok()   { printf 'ok:   %s\n' "$1"; }

shopt -s nullglob
pkgs=("$build_dir"/*.pkg.tar.zst)
shopt -u nullglob
(( ${#pkgs[@]} >= 2 )) || fail "빌드 산출물이 부족하다: ${#pkgs[@]} (build-packages 를 먼저 돌린다)"

# 1) 로컬 pacman 저장소
mkdir -p "$local_repo"
cp "${pkgs[@]}" "$local_repo/"
( cd "$local_repo" && repo-add --quiet coo.db.tar.gz ./*.pkg.tar.zst ) \
  || fail "repo-add 실패"
ok "로컬 저장소 생성: ${#pkgs[@]} 개"

if ! grep -q '^\[coo\]' /etc/pacman.conf; then
  printf '\n[coo]\nSigLevel = Optional TrustAll\nServer = file://%s\n' "$local_repo" \
    >> /etc/pacman.conf
fi

# 2) 게이트 B 사전조건. omarchy 는 conflicts 검증 대상이고,
# omarchy-settings 는 현재 conflicts 대상이 아닌 깨끗한 이미지 기준선이다.
if pacman -Q omarchy >/dev/null 2>&1; then
  fail "게이트 B 사전조건: 깨끗한 이미지에 omarchy 가 이미 설치됨"
fi
ok "게이트 B 사전조건: 깨끗한 이미지에 omarchy 없음"

if pacman -Q omarchy-settings >/dev/null 2>&1; then
  fail "게이트 B 기준선: 깨끗한 이미지에 omarchy-settings 가 이미 설치됨"
fi
ok "게이트 B 기준선: 깨끗한 이미지에 omarchy-settings 없음"

# 3) 부분 업그레이드를 피한 뒤 의존을 해석시켜 설치한다.
pacman -Syu --noconfirm >/dev/null || fail "pacman -Syu 실패"
pacman -S --noconfirm cachy-omarchy-overlay || fail "게이트 A: 의존 해석 설치 실패"
ok "게이트 A: pacman -S 가 의존을 해석해 설치했다"

# overlay 만 요청했으므로 shell 은 depends 로 끌려와야 한다.
pacman -Q cachy-omarchy-shell >/dev/null 2>&1 \
  || fail "게이트 A: cachy-omarchy-shell 이 depends 로 끌려오지 않았다"
ok "게이트 A: 패키지 간 의존이 같은 트랜잭션으로 해석됐다"

# 4) 게이트 B 설치 후 재확인. omarchy 부재는 conflicts 결과이고,
# omarchy-settings 부재는 설치가 깨끗한 이미지 기준선을 보존한 결과다.
if pacman -Q omarchy >/dev/null 2>&1; then
  fail "게이트 B conflicts: 설치 뒤 omarchy 가 존재함"
fi
ok "게이트 B conflicts: 설치 뒤 omarchy 없음"

if pacman -Q omarchy-settings >/dev/null 2>&1; then
  fail "게이트 B 기준선: 설치 뒤 omarchy-settings 가 존재함"
fi
ok "게이트 B 기준선: 설치 뒤 omarchy-settings 없음"

# 4) 게이트 C — 여기가 이 lane 의 값어치다.
#
#    설치가 됐다는 것은 depends 가 해결 가능하다는 뜻일 뿐이다. 충분하다는
#    것은 우리 헬퍼가 부르는 명령이 실제로 PATH 에 있다는 뜻이다. 스캐너는
#    평소 샌드박스에 풀어놓은 아카이브를 보지만, 여기서는 진짜 pacman -S 로
#    설치된 트리를 본다 — 같은 도구, 훨씬 강한 주장.
installed_root=${COO_INSTALLED_ROOT:-/}
[[ -d "$installed_root/usr/share/cachy-omarchy/upstream" ]] \
  || fail "게이트 C: 설치된 upstream 트리가 없다: $installed_root/usr/share/cachy-omarchy/upstream"
[[ -d "$installed_root/usr/lib/cachy-omarchy/compat/bin" ]] \
  || fail "게이트 C: 설치된 overlay compat 트리가 없다: $installed_root/usr/lib/cachy-omarchy/compat/bin"

# closure_check.py 의 --tree 는 /usr/share/cachy-omarchy 가 아니라 패키지
# 루트를 받는다. 기존 테스트의 추출 트리는 tree/usr/share/... 와
# tree/overlay/usr/lib/... 로 나뉘고, 스캐너는 그 overlay/ 분기부터 먼저
# 찾는다. pacman 설치 후에는 /usr/share/... 와 /usr/lib/... 이 한 루트 아래라
# overlay/ 분기가 없고 두 번째 실설치 분기(/usr/lib/cachy-omarchy/compat/bin)가
# 선택된다. 그러므로 / 를 넘긴다.
python3 "$repo_root/tests/runtime/closure_check.py" \
  --tree "$installed_root" \
  --repo "$repo_root" \
  --map "$repo_root/tests/data/command-packages.tsv" \
  --upstream-helpers "$repo_root/tests/data/upstream-helpers.txt" \
  --exceptions "$repo_root/tests/data/closure-exceptions.tsv" \
  || fail "게이트 C: HARD 명령이 실설치 트리에서 해결되지 않는다 — depends 선언 누락"
ok "게이트 C: 폐쇄 스캐너가 실설치 트리에서 통과했다"

printf '의존 해석 lane 통과\n'
