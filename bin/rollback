#!/usr/bin/env bash
# Reinstall, per package, the newest build/ artifact older than the installed
# version (SPEC §36). A package with nothing older in build/ is left as is.
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
build_dir=${COO_BUILD_DIR:-$repo_root/build}
pacman_bin=${COO_PACMAN_BIN:-}
sudo_bin=${COO_SUDO_BIN:-sudo}
vercmp_bin=${COO_VERCMP_BIN:-vercmp}
smoke_bin=${COO_ROLLBACK_SMOKE_BIN:-}
fail() { printf 'error: %s\n' "$1" >&2; exit 1; }

# Same elevation rule as install-packages. Queries never need root.
if [[ -n $pacman_bin ]]; then
  pacman_cmd=("$pacman_bin"); query_cmd=("$pacman_bin")
elif (( EUID == 0 )); then
  fail 'do not run rollback with sudo; run it as your normal user — it elevates only the pacman transaction itself. Usage: ./bin/rollback'
else
  pacman_cmd=("$sudo_bin" pacman); query_cmd=(pacman)
fi

case ${1:-} in
  --help) printf 'Usage: rollback\n'; exit 0 ;;
  '') ;;
  *) fail "unknown argument: $1" ;;
esac

# Prints the newest build/ artifact of $1 older than the installed version,
# or nothing when there is none.
previous_artifact() {
  local pkg=$1 installed f ver best="" best_ver=""
  installed=$("${query_cmd[@]}" -Q "$pkg" 2>/dev/null) || fail "$pkg is not installed"
  installed=${installed#"$pkg "}
  for f in "$build_dir/$pkg"-*-any.pkg.tar.zst; do
    [[ -f $f ]] || continue
    ver=${f##*/}; ver=${ver#"$pkg-"}; ver=${ver%-any.pkg.tar.zst}
    (( $("$vercmp_bin" "$ver" "$installed") < 0 )) || continue
    if [[ -z $best_ver ]] || (( $("$vercmp_bin" "$ver" "$best_ver") > 0 )); then
      best=$f best_ver=$ver
    fi
  done
  printf '%s' "$best"
}

targets=()
for pkg in cachy-omarchy-shell cachy-omarchy-overlay; do
  artifact=$(previous_artifact "$pkg")
  if [[ -n $artifact ]]; then
    targets+=("$artifact")
  else
    printf 'note: no older %s in build/; keeping the installed version\n' "$pkg"
  fi
done
(( ${#targets[@]} )) || fail 'nothing older in build/ to roll back to'

"${pacman_cmd[@]}" -U "${targets[@]}"
[[ -z $smoke_bin ]] || "$smoke_bin"
printf 'rolled back to: %s\n' "${targets[@]##*/}"
