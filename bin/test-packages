#!/usr/bin/env bash
# Test only the current, checksum-validated build (SPEC §33, M6 U08).
set -euo pipefail

repo_root=${COO_REPO_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}
state_dir=${COO_STATE_DIR:-${XDG_STATE_HOME:-$HOME/.local/state}/cachy-omarchy}
sha256_bin=${COO_SHA256_BIN:-sha256sum}
test_runner=${COO_TEST_RUNNER:-$repo_root/tests/test.sh}
# shellcheck disable=SC1091
source "$repo_root/bin/validated-build.sh"

usage() { printf 'Usage: test-packages\n'; }
case ${1:-} in
  --help) usage; exit 0 ;;
  '') ;;
  *) coo_fail "unknown argument: $1"; exit 1 ;;
esac

manifest=$state_dir/validated-build.manifest
coo_validate_current_manifest "$repo_root" "$state_dir" "$manifest" "$sha256_bin" || exit 1
[[ -x $test_runner ]] || { coo_fail "test runner is not executable: $test_runner"; exit 1; }

out=$(mktemp "${TMPDIR:-/tmp}/coo-test-packages-XXXXXX")
trap 'rm -f "$out"' EXIT
set +e
env -u COO_STATE_DIR "$test_runner" >"$out" 2>&1
status=$?
set -e
cat "$out"
if (( status != 0 )); then
  printf 'error: test runner failed: %s\n' "$status" >&2
  exit "$status"
fi
# Artifact/source skips are false-green failures. The only allowed skips are
# explicit opt-in key injection, an absent/unusable Wayland runtime for
# live-only smoke checks, an absent real uwsm-app for the Tier 2
# scope-isolation live check (uwsm-less hosts are the original target — the
# test must not silently verify Tier 1 fallback instead), and the
# update-pipeline's own nested candidate run skipping the closure table's
# doc-sync check (that check compares the checked-in doc against a synthetic
# fixture pin — a structural mismatch, not a missed build). An absent
# wayland-wm-app-daemon is a note, not a skip: the negative control still ran.
unexpected_skips=$(grep -F 'skip:' "$out" | grep -Fv 'skip: 라이브 키 주입 (COO_RUN_LIVE=1 필요)' | grep -Fv 'skip: 라이브 Wayland 런타임 없음 (quickshell/qs/systemd-cat 사용 불가 또는 WAYLAND_DISPLAY 소켓 없음)' | grep -Fv 'skip: 실제 uwsm-app 이 PATH 에 없다 — Tier 2 스코프 격리를 검증할 수 없다 (uwsm 미설치 호스트)' | grep -Fv 'skip: COO_RUN_LIVE=1 이 아니다' | grep -Fv 'skip: COO_UPDATE_PIPELINE_NESTED=1 픽스처 핀이라 실제 저장소 문서와 표가 구조적으로 다르다' || true)
if [[ -n $unexpected_skips ]]; then
  printf '%s\n' "$unexpected_skips" >&2
  coo_fail 'test runner skipped required coverage'
  exit 1
fi
printf 'validated package tests passed\n'
