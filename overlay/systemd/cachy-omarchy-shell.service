[Unit]
Description=Cachy Omarchy Quattro Shell
PartOf=graphical-session.target
After=graphical-session.target
# Upstream units guard with ConditionEnvironment when session-scoped (e.g. omarchy-crash-watch.service);
# prevents execution in headless SSH sessions where the wrapper would fail to attach a Wayland display
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/cachy-omarchy-shell --run
Restart=on-failure
RestartSec=1

[Install]
# graphical-session.target is the standard install target for session-scoped services
# (upstream does not use a systemd unit for the shell; this matches upstream's convention for other session services)
WantedBy=graphical-session.target
