#!/usr/bin/env bash
# 락 인지 셸 재시작. 기동과 IPC 는 업스트림 omarchy-launch-shell / omarchy-shell
# 이 맡는다(basecamp/omarchy @ 핀, MIT) — 이 명령은 업스트림 omarchy-restart-shell
# 이 의존하는 미스테이징 omarchy-hyprland-session-locked 가 없는 자리를 메운다.
set -uo pipefail

PREFIX_ROOT=${COO_PREFIX_ROOT:-/usr/share/cachy-omarchy}
OMARCHY_PATH=${COO_OMARCHY_PATH:-$PREFIX_ROOT/upstream}
export OMARCHY_PATH

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
사용법: cachy-omarchy-shell --restart

  --restart   세션이 잠겨 있지 않을 때만 실행 중 셸을 정상 종료시키고 업스트림
              omarchy-launch-shell 로 다시 띄운다.
  --help      이 도움말.

기동은 omarchy-launch-shell, IPC 는 omarchy-shell 을 직접 쓴다.

환경:
  COO_OMARCHY_PATH   업스트림 루트 override (기본: /usr/share/cachy-omarchy/upstream)
  COO_IPC_TIMEOUT    락 조회 IPC 타임아웃 (기본 2s)
USAGE
}

cmd_restart() {
  [[ -f $OMARCHY_PATH/shell/shell.qml ]] \
    || fail "셸 트리를 찾을 수 없다: $OMARCHY_PATH/shell/shell.qml"

  # 세션이 잠긴 동안 재시작하면 화면 잠금 클라이언트(hyprlock)가 함께 죽어
  # 세션이 Hyprland failsafe 뒤에 갇힌다(RUNTIME_STARTUP §22.4). 고아 락을
  # 판별해 재획득까지 시도하는 업스트림 omarchy-hyprland-session-locked 경로는
  # 범위 밖(closure-exceptions.tsv 의 blocked 행) — 우리는 거부만 한다.
  #
  # 셸이 없거나 응답하지 않거나 lock 플러그인이 없으면(omarchy-shell 이 IPC
  # 레벨 오류도 nonzero 로 올린다) 보존할 락도 없으므로 진행한다. 단 "아직
  # 준비되지 않음" 은 락 서비스가 로드 중일 수 있어 진행하지 않는다. 응답이
  # 왔는데 스키마가 온전한 "잠기지 않음" 이 아니면 거부한다: 잘못 진행하면
  # hyprlock 을 죽여 세션이 갇히는 중대 사고이고, 잘못 거부하면 재시작 한 번을
  # 손해 보는 경미한 사고이기 때문이다. 정리: **스키마가 온전한 "unlocked"
  # 응답만 진행, 락 서비스 부재·셸 부재도 진행, 그 외 전부 거부.**
  #
  # 셸 자신이 판정한 값(lock/Service.qml 의 `locked`)을 우선 쓴다.
  local lock_out lock_err lock_status locking err_file
  err_file=$(mktemp) || fail "임시 파일을 만들 수 없다"
  lock_out=$(OMARCHY_SHELL_IPC_TIMEOUT=${COO_IPC_TIMEOUT:-2s} \
    omarchy-shell lock status 2>"$err_file")
  lock_status=$?
  lock_err=$(<"$err_file")
  rm -f "$err_file"
  if (( lock_status == 0 )); then
    locking=$(printf '%s' "$lock_out" \
      | jq -r 'if (has("locked") and has("secure") and has("requested"))
                then (.locked or .secure or .requested) else "unknown" end' 2>/dev/null)
    [[ $locking == "false" ]] \
      || fail "Refusing to restart the shell while the session is locked."
  elif [[ $lock_err == *"not ready"* ]]; then
    fail "Refusing to restart the shell while it is still starting (lock state unknown)."
  fi

  # 업스트림 감독자(omarchy-launch-shell)는 비정상 종료면 재기동한다. TERM 으로
  # 죽이면 감독자가 새로 띄우고 우리도 새로 띄워 셸이 이중 기동하므로, 업스트림
  # omarchy-restart-shell 처럼 quickshell kill(정상 종료)로 멈춘다. kill 한 번은
  # 가장 오래된 인스턴스 하나를 완전히 종료한 뒤 돌아온다.
  local n=0
  while (( n < 10 )) && timeout 5 quickshell kill -p "$OMARCHY_PATH/shell" --any-display >/dev/null 2>&1; do
    n=$((n + 1))
  done

  # kill 이 돌아온 직후에도 죽어가는 인스턴스가 남아 있을 수 있다(IPC 종료 뒤
  # 엔진 정리 중). 이때 새로 띄우면 "already running" 으로 exit 0 하고 감독자가
  # 그것을 의도된 정지로 읽어 셸이 영영 안 뜬다 — 사라질 때까지 잠깐 기다린다.
  n=0
  while (( n < 50 )) && pgrep -f "quickshell -n -p $OMARCHY_PATH/shell" >/dev/null 2>&1; do
    sleep 0.1; n=$((n + 1))
  done

  # Hyprland 에서 띄워 정식 세션 환경을 상속시킨다(터미널·SSH 의 일시 변수 배제).
  hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' >/dev/null 2>&1 \
    || fail "Hyprland 에 omarchy-launch-shell 기동을 요청하지 못했다"

  local attempt
  for (( attempt = 0; attempt < 50; attempt++ )); do
    if OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  fail "Omarchy shell did not become ready after restart."
}

case ${1:-} in
  --restart) shift; cmd_restart "$@" ;;
  --run|--ipc|--path)
    printf 'error: cachy-omarchy-shell %s 는 삭제됐다 — 기동은 omarchy-launch-shell, IPC 는 omarchy-shell 을 쓴다.\n' "$1" >&2
    printf '       예전 bindings.lua 가 --run 을 부르면: cachy-omarchy-bindings --force\n' >&2
    exit 1 ;;
  --help|"") usage ;;
  *) printf 'error: 알 수 없는 인자: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
