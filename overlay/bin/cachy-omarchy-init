#!/usr/bin/env bash
# 최초 사용 시 사용자 설정을 만든다. 패키지 post-install 이 아니라 유저 레벨
# 헬퍼다 (SPEC 38). 기존 사용자 파일을 절대 덮어쓰지 않는다 (SPEC 6.6).
set -uo pipefail

here=$(cd "$(dirname -- "$0")" && pwd)

PREFIX_ROOT=${COO_PREFIX_ROOT:-/usr/share/cachy-omarchy}
CONFIG_DIR=${COO_CONFIG_DIR:-$HOME/.config/cachy-omarchy}
STATE_DIR=${COO_STATE_DIR:-$HOME/.local/state/omarchy}
TOGGLES_DIR=$STATE_DIR/toggles
DRY=0

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }
note() { printf '%s\n' "$1"; }
act()  { (( DRY )) && printf 'would: %s\n' "$1" || printf '%s\n' "$1"; }

usage() {
  cat <<'USAGE'
사용법: cachy-omarchy-init [--dry-run] [--force]

최초 사용 시 사용자 설정을 만든다. 이미 있는 파일은 건드리지 않는다.

만드는 것:
  ~/.config/cachy-omarchy/hypr/bindings.{conf,lua}
  사용자 Hyprland 설정에 관리 source 블록       (충돌 시 주입하지 않음)
  기본 테마 시드 "Tokyo Night"                  (테마가 없을 때만, SPEC 6.6)
  /etc/pam.d/omarchy-lock-password              (없을 때만, omarchy-apply-lock
                                                 에 위임 — sudo 를 물을 수 있음)

잠금 화면 PAM 서비스가 없으면 omarchy-system-lock 은 exit 0 인 채 아무것도
잠그지 않는다. 이 단계가 실패해도 init 은 계속 진행하며, 나중에
omarchy-apply-lock 을 직접 실행해 복구할 수 있다.

Omarchy 내장 바는 기본으로 보인다. 숨기려면 직접 토글을 만든다:
  : > ~/.local/state/omarchy/toggles/bar-off

주의: 셸 설정(~/.config/cachy-omarchy/shell.json)은 만들지 않는다.
셸은 ~/.config/omarchy/shell.json 을 읽지 이 경로를 읽지 않으므로,
여기에 파일을 만들어도 사용자 편집이 조용히 무시된다. 패키지 기본값은
/usr/share/cachy-omarchy/upstream/config/omarchy/shell.json 으로
스테이징되며 init 없이도 적용된다.

참고: 내장 바는 화면 상단에 26px 를 예약한다. 이 명령의 실행 여부와는
무관하며 — init 은 바를 켜지도 끄지도 않는다 — 위의 bar-off 토글로만 끈다.

옵션:
  --dry-run  무엇을 할지 출력만 하고 아무것도 쓰지 않는다.
  --force    바인딩 충돌이 있어도 관리 블록을 넣는다 (사용자 줄은 지우지 않음).
  --help     이 도움말.
USAGE
}

FORCE_ARGS=()
while (( $# )); do
  case $1 in
    --dry-run) DRY=1 ;;
    --force)   FORCE_ARGS+=(--force) ;;
    --help|-h) usage; exit 0 ;;
    *) printf 'error: 알 수 없는 인자: %s\n' "$1" >&2; usage >&2; exit 1 ;;
  esac
  shift
done

# 1) 셸 설정(~/.config/cachy-omarchy/shell.json)은 만들지 않는다.
#    shell.qml:31 이 읽는 사용자 경로는 ~/.config/omarchy/shell.json 이지 이
#    경로가 아니므로, 여기에 파일을 만들면 사용자 편집이 조용히 무시된다.
#    패키지 기본값은 /usr/share/cachy-omarchy/upstream/config/omarchy/shell.json
#    으로 스테이징되며 init 없이도 셸이 적용한다. 기존 사용자가 이 dead file
#    을 갖고 있다면 cachy-omarchy-doctor 가 WARN 으로 알린다.

# 2) bar 토글은 만들지 않는다. M8 원칙 0 — cachy-omarchy 를 설치한다는 것은
#    omarchy 가 주는 것을 쓰겠다는 의사이므로 업스트림 기본값(바 표시)이
#    기본이다. 바를 끄고 싶으면 사용자가 직접 토글을 만든다:
#      : > ~/.local/state/omarchy/toggles/bar-off
#    0.1.x init 이 만들어 둔 기존 bar-off 는 사용자 상태이므로 지우지 않는다
#    (SPEC 6.6). cachy-omarchy-doctor 가 존재를 알리고 삭제 방법을 안내한다.
if [[ -e $TOGGLES_DIR/bar-off ]]; then
  note "유지: $TOGGLES_DIR/bar-off (0.1.x 가 만든 억제 토글 — 지우지 않는다. 바를 보려면 직접 삭제)"
fi

# 2.5) 기본 테마 시드 (M9, upstream install/user/theme.sh 와 동일 시맨틱).
#    theme.name 이 이미 있으면 사용자 선택이므로 절대 덮어쓰지 않는다
#    (SPEC 6.6). 존재 조건은 upstream 과 같이 ! -s 다 — 빈 파일도 부재로
#    취급해 재시드한다. 셸이 떠 있으면 일반 경로로 적용해 실행 중 팔레트도
#    바로 갱신하고, 아니면 OMARCHY_THEME_HEADLESS=1 로 symlink 만 놓는다 —
#    셸은 다음 기동 때 current/theme 을 읽는다. 바인딩 주입(아래 3절)보다
#    먼저 와야 conf 관리 블록의 테마 source 조건이 성립한다 (D5).
# 테마 시드는 세션 밖(TTY·SSH)에서도 돌 수 있다 — uwsm 세션 환경을 전제할 수
# 없으므로 OMARCHY_PATH 를 명시적으로 준다. 명령 자체는 /usr/bin/omarchy-theme-set
# 심링크로 노출된다 (SPEC §45).
THEME_SET=$(command -v omarchy-theme-set 2>/dev/null || true)
if [[ -n $THEME_SET ]]; then
  if [[ ! -s $HOME/.local/state/omarchy/current/theme.name ]]; then
    if (( DRY )); then
      note "would: $THEME_SET \"Tokyo Night\" (기본 테마 시드)"
    elif pgrep -f "quickshell -n -p .*shell" >/dev/null 2>&1; then
      OMARCHY_PATH=$PREFIX_ROOT/upstream "$THEME_SET" "Tokyo Night" \
        || note "note: 테마 시드 실패 — omarchy-theme-set \"Tokyo Night\" 로 수동 적용 가능"
    else
      OMARCHY_PATH=$PREFIX_ROOT/upstream OMARCHY_THEME_HEADLESS=1 "$THEME_SET" "Tokyo Night" \
        || note "note: 테마 시드 실패 — 셸 첫 기동 후 omarchy-theme-set \"Tokyo Night\" 로 수동 적용 가능"
    fi
  fi
else
  note "note: omarchy-theme-set 없음 — 테마 시드를 건너뛴다"
fi

# 2.6) 잠금 화면 PAM 서비스. 업스트림은 install/config/lockscreen-pam.sh 에서
#    omarchy-apply-lock 을 한 번 돌려 /etc/pam.d/omarchy-lock-password 를
#    만든다. 우리는 업스트림 설치 스크립트를 쓰지 않으므로 그 자리를 여기서
#    메운다 — 스탠자를 복사하지 않고 같은 헬퍼에 위임한다 (SPEC 20).
#    이것이 없으면 lock 플러그인이 passwordPamConfigured=false 로 남아
#    IPC lock.lock 이 "missing-pam" 을 돌려주고, omarchy-system-lock 은 그
#    출력을 버리므로 exit 0 인 채 아무것도 잠기지 않는다.
#    이미 있으면 부르지 않는다 — 파일 존재 확인만으로 멱등하고 sudo 도 필요
#    없다. 실패는 격하한다: 잠금 설정 때문에 아래 바인딩 설치가 막히면 안 된다.
PAM_LOCK_FILE=${COO_PAM_LOCK_FILE:-/etc/pam.d/omarchy-lock-password}
APPLY_LOCK=$(command -v omarchy-apply-lock 2>/dev/null || true)
if [[ -e $PAM_LOCK_FILE ]]; then
  : # 이미 설정됨 — 사용자 시스템 상태이므로 다시 쓰지 않는다.
elif [[ -z $APPLY_LOCK ]]; then
  note "note: omarchy-apply-lock 없음 — 잠금 화면 PAM 설정을 건너뛴다 (omarchy-system-lock 은 아무것도 잠그지 못한다)"
elif (( DRY )); then
  note "would: $APPLY_LOCK (잠금 화면 PAM 설정 $PAM_LOCK_FILE — sudo 필요)"
else
  note "잠금 화면 PAM 설정을 만든다: $PAM_LOCK_FILE (root 권한이 필요해 sudo 암호를 물을 수 있다)"
  "$APPLY_LOCK" \
    || note "note: 잠금 화면 PAM 설정 실패 — 나중에 omarchy-apply-lock 을 직접 실행할 수 있다"
fi

# 3) Hyprland 바인딩. 충돌 감지와 --force 정책을 재구현하지 않고 위임한다
#    (SPEC 20). bindings 헬퍼는 형제로 설치돼 있다.
SIBLING_BINDINGS=$here/cachy-omarchy-bindings
BINDINGS=$SIBLING_BINDINGS
PATH_BINDINGS=""
if [[ ! -x $BINDINGS ]]; then
  PATH_BINDINGS=$(command -v cachy-omarchy-bindings 2>/dev/null || true)
  BINDINGS=$PATH_BINDINGS
fi
[[ -n $BINDINGS && -x $BINDINGS ]] \
  || fail "cachy-omarchy-bindings 를 찾을 수 없다 (시도: $SIBLING_BINDINGS, PATH: ${PATH_BINDINGS:-<없음>})"

if (( DRY )); then
  note "would: $BINDINGS ${FORCE_ARGS[*]-} (관리 블록 설치)"
else
  COO_CONFIG_DIR=$CONFIG_DIR "$BINDINGS" "${FORCE_ARGS[@]}" \
    || fail "바인딩 설치 실패 — 위 메시지를 확인할 것"
fi

(( DRY )) && note "--dry-run: 아무것도 쓰지 않았다."
exit 0
