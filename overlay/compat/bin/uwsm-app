#!/usr/bin/env bash
# AppLibrary.launch 은 `uwsm-app -- gtk-launch <id>.desktop` 을 부른다.
# 실제 uwsm-app 은 실행한 앱을 app-graphical.slice 아래 자신만의 systemd
# scope 에 넣어 셸 프로세스의 생명주기에서 떼어낸다 (shell/services/
# AppLibrary.qml:81-85). 이 shim 은 그 스코프 격리를 흉내내지 않는다 —
# 실제 uwsm-app 이 있으면 위임하고, 없으면 오늘까지의 동작(`--` 벗기고 exec)
# 을 그대로 유지한다 (SPEC 44 WRAPPER).
#
# uwsm 이 설치되면 PATH 상 실제 uwsm-app 이 나타나지만, 이 compat 디렉터리가
# 셸 프로세스 PATH 맨 앞에 붙기 때문에(SPEC 45) 이 shim 이 계속 먼저 잡힌다.
# 그래서 실제 구현을 발견하면 원래 인자(`--` 포함) 그대로 위임한다 — shim 은
# 투명해야지 똑똑해지면 안 된다.
#
# 자기 자신으로 되돌아가는 재귀를 막기 위해, PATH 후보를 경로 문자열이 아니라
# `readlink -f` 로 정규화한 실제 경로로 이 스크립트 자신과 비교한다. 심볼릭
# 링크로 배포돼도(정규화하면 같은 경로로 수렴) 재귀하지 않고, 다른 경로에
# 복사돼도(정규화하면 다른 경로) 정당한 "다음 구현"으로 인식된다.
set -uo pipefail

self=$(readlink -f -- "$0" 2>/dev/null || printf '%s' "$0")

resolve_real_uwsm_app() {
  local dir candidate resolved
  local IFS=:
  for dir in $PATH; do
    [[ -n $dir ]] || continue
    candidate="$dir/uwsm-app"
    [[ -x $candidate && ! -d $candidate ]] || continue
    resolved=$(readlink -f -- "$candidate" 2>/dev/null || printf '%s' "$candidate")
    [[ $resolved == "$self" ]] && continue
    printf '%s' "$candidate"
    return 0
  done
  return 1
}

if real=$(resolve_real_uwsm_app); then
  exec "$real" "$@"
fi

# 실제 uwsm-app 이 아직 없다 (이 호스트는 오늘 그렇다). 기존 동작 유지:
# `--` 를 벗기고 나머지를 exec.
if [[ ${1:-} == -- ]]; then
  shift
fi
(( $# >= 1 )) || { printf 'error: uwsm-app: missing command\n' >&2; exit 1; }
exec "$@"
