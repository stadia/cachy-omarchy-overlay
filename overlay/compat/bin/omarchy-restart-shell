#!/usr/bin/env bash
# 락 인지 셸 재시작. 업스트림 헬퍼/메뉴가 부르는 `omarchy-restart-shell` 자리를
# 채운다 (SPEC 44). 업스트림 원본은 미스테이징 omarchy-hyprland-session-locked
# (의도적 milestone=blocked)와 omarchy-system-sleep-lock 을 전제하므로 verbatim
# 을 올리지 않고, 기동은 업스트림 omarchy-launch-shell, IPC 는 omarchy-shell 에
# 맡기고(basecamp/omarchy @ 핀, MIT) 락 판정·kill·재기동만 여기서 한다.
set -uo pipefail

PREFIX_ROOT=${COO_PREFIX_ROOT:-/usr/share/cachy-omarchy}
OMARCHY_PATH=${COO_OMARCHY_PATH:-$PREFIX_ROOT/upstream}
export OMARCHY_PATH

fail() { printf 'error: %s\n' "$1" >&2; exit 1; }

usage() {
  cat <<'USAGE'
사용법: omarchy-restart-shell

세션이 잠겨 있지 않을 때만 실행 중 셸을 정상 종료시키고 업스트림
omarchy-launch-shell 로 다시 띄운다. 락 상태를 알 수 없으면(기동 중·무응답
포함) 거부한다.

환경:
  COO_OMARCHY_PATH   업스트림 루트 override (기본: /usr/share/cachy-omarchy/upstream)
  COO_IPC_TIMEOUT    락 조회 IPC 타임아웃 (기본 2s)
USAGE
}

cmd_restart() {
  [[ -f $OMARCHY_PATH/shell/shell.qml ]] \
    || fail "셸 트리를 찾을 수 없다: $OMARCHY_PATH/shell/shell.qml"

  # 세션이 잠긴 동안 재시작하면 화면 잠금 클라이언트(hyprlock)가 함께 죽어
  # 세션이 Hyprland failsafe 뒤에 갇힌다(RUNTIME_STARTUP §22.4). 고아 락을
  # 판별해 재획득까지 시도하는 업스트림 omarchy-hyprland-session-locked 경로는
  # 범위 밖(closure-exceptions.tsv 의 blocked 행) — 우리는 거부만 한다.
  #
  # 잘못 진행하면 hyprlock 을 죽여 세션이 갇히는 중대 사고이고, 잘못 거부하면
  # 재시작 한 번을 손해 보는 경미한 사고이기 때문에 **허용 목록**으로 판정한다:
  # 스키마가 온전한 "unlocked" 응답, 그리고 보존할 락이 확실히 없는 두 경우
  # (셸 미실행 = "is not running", lock 플러그인 부재 = "Target not found.")만
  # 진행하고, 그 밖의 전부(무응답·기동 중·알 수 없는 오류·명령 부재)는 거부한다.
  #
  # 판정은 셸 자신이 계산한 `locked` 에 secure/requested 를 OR 한 값이다.
  local lock_out lock_err lock_status locking err_file
  err_file=$(mktemp) || fail "임시 파일을 만들 수 없다"
  trap 'rm -f "$err_file"' RETURN
  lock_out=$(OMARCHY_SHELL_IPC_TIMEOUT=${COO_IPC_TIMEOUT:-2s} \
    omarchy-shell lock status 2>"$err_file")
  lock_status=$?
  lock_err=$(<"$err_file")
  if (( lock_status == 0 )); then
    locking=$(printf '%s' "$lock_out" \
      | jq -r 'if (has("locked") and has("secure") and has("requested"))
                then (.locked or .secure or .requested) else "unknown" end' 2>/dev/null)
    [[ $locking == "false" ]] \
      || fail "Refusing to restart the shell while the session is locked."
  else
    case $lock_err in
      *"is not running"*|*"Target not found."*) ;;
      *) fail "Refusing to restart the shell: lock state unknown (${lock_err:-omarchy-shell exited $lock_status})." ;;
    esac
  fi

  # 새 셸은 Hyprland 에서 띄워 정식 세션 환경을 상속시킨다. SSH/TTY 에서 불린
  # 경우를 위해 업스트림 omarchy-restart-shell 처럼 인스턴스 서명을 복구하고,
  # 셸을 죽이기 전에 Hyprland 에 닿는지 확인한다 — 죽인 뒤에야 재기동 불가를
  # 알면 세션이 셸 없이 남는다.
  if [[ -z ${HYPRLAND_INSTANCE_SIGNATURE:-} ]]; then
    local hypr_dir
    hypr_dir=$(find "${XDG_RUNTIME_DIR:-/run/user/$UID}/hypr" -mindepth 1 -maxdepth 1 -type d \
      -printf '%T@ %p\n' 2>/dev/null | sort -n | tail -n 1 | cut -d' ' -f2-)
    [[ -n $hypr_dir ]] && export HYPRLAND_INSTANCE_SIGNATURE=${hypr_dir##*/}
  fi
  local hypr_err
  hypr_err=$(hyprctl -j monitors 2>&1 >/dev/null) \
    || fail "Hyprland 에 닿지 못해 재시작하지 않는다: ${hypr_err:-hyprctl failed}"

  # 업스트림 감독자(omarchy-launch-shell)는 비정상 종료면 재기동한다. TERM 으로
  # 죽이면 감독자가 새로 띄우고 우리도 새로 띄워 셸이 이중 기동하므로, 업스트림
  # omarchy-restart-shell 처럼 quickshell kill(정상 종료)로 멈춘다. 한 번의 kill
  # 은 인스턴스 하나만 멈추므로 더 없을 때까지 반복한다.
  local n=0
  while (( n < 10 )) && timeout 5 quickshell kill -p "$OMARCHY_PATH/shell" --any-display >/dev/null 2>&1; do
    n=$((n + 1))
  done

  # kill 이 돌아온 직후에도 죽어가는 인스턴스가 남아 있을 수 있다(IPC 종료 뒤
  # 엔진 정리 중). 이때 새로 띄우면 "already running" 으로 exit 0 하고 감독자가
  # 그것을 의도된 정지로 읽어 셸이 영영 안 뜬다. 끝내 안 사라지면 옛 인스턴스가
  # ping 에 답해 거짓 성공이 되므로 여기서 실패한다.
  n=0
  while (( n < 50 )) && pgrep -f "quickshell -n -p $OMARCHY_PATH/shell" >/dev/null 2>&1; do
    sleep 0.1; n=$((n + 1))
  done
  pgrep -f "quickshell -n -p $OMARCHY_PATH/shell" >/dev/null 2>&1 \
    && fail "이전 셸이 종료되지 않았다 — 새로 띄우지 않는다."

  hypr_err=$(hyprctl dispatch 'hl.dsp.exec_cmd("omarchy-launch-shell")' 2>&1 >/dev/null) \
    || fail "Hyprland 에 omarchy-launch-shell 기동을 요청하지 못했다: ${hypr_err:-hyprctl failed}"

  local attempt
  for (( attempt = 0; attempt < 50; attempt++ )); do
    if OMARCHY_SHELL_IPC_TIMEOUT=0.5s omarchy-shell shell ping >/dev/null 2>&1; then
      return 0
    fi
    sleep 0.1
  done
  fail "Omarchy shell did not become ready after restart."
}

# 업스트림 호출자는 인자를 주지 않는다. 공개 이름이므로 --help 나 오타가
# 셸 재시작으로 바뀌지 않게 먼저 거른다.
case ${1:-} in
  "") cmd_restart ;;
  --help) usage ;;
  *) printf 'error: 알 수 없는 인자: %s\n' "$1" >&2; usage >&2; exit 1 ;;
esac
