#!/usr/bin/env bash
# compat shim: 업스트림 헬퍼/메뉴가 부르는 `omarchy-restart-shell` 을 우리
# 락 인지 재시작 cachy-omarchy-shell --restart 로 연결한다 (SPEC 44).
#
# 업스트림 원본은 미스테이징 헬퍼 3개(omarchy-hyprland-session-locked —
# 의도적 milestone=blocked, omarchy-launch-shell, omarchy-system-sleep-lock)
# 를 전제한다. 그래서 verbatim 을 올리지 않고, 락 조회·kill·재기동 로직이 이미
# 있는 --restart 로 위임한다. 여기서 kill/재시작·락 판단을 이중화하지 않는다.
set -uo pipefail

# 업스트림 호출자는 인자를 주지 않는다. 공개 이름이므로 --help 나 오타가
# 셸 재시작으로 바뀌지 않게 먼저 거른다.
case ${1:-} in
  "") exec "${COO_SHELL_BIN:-cachy-omarchy-shell}" --restart ;;
  --help)
    printf '사용법: omarchy-restart-shell\n\n락 인지 셸 재시작 — cachy-omarchy-shell --restart 로 위임한다. 세션이 잠겨 있으면 거부한다.\n'
    ;;
  *) printf 'error: 알 수 없는 인자: %s\n' "$1" >&2; exit 1 ;;
esac
