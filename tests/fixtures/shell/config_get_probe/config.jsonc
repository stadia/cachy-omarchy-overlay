{
  // Fixture for tests/shell/test_config_get.sh. Exercises every leaf type
  // Config.get() must degrade past without throwing: string, number,
  // boolean, explicit null, plus a genuinely nested object for the
  // valid-multi-segment-path control case.
  "version": "0.1.0-dev",
  "str": "hello",
  "num": 42,
  "boolVal": true,
  "nil": null,
  "nested": {
    "a": {
      "b": 1
    }
  }
}
