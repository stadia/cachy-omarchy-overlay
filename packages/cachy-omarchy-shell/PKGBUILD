# Maintainer: Cachy Omarchy Overlay
pkgname=cachy-omarchy-shell
pkgver=4.0.0
pkgrel=1
pkgdesc='Pinned Omarchy Quattro shell runtime for CachyOS (no omarchy-settings)'
arch=('any')
url='https://github.com/basecamp/omarchy'
license=('MIT')
depends=('quickshell' 'hyprland' 'inotify-tools')
makedepends=('git')
_commit='f0020448ca87329199de7cb12f2015ebc4a3e5e7'

if [[ -n ${COO_OMARCHY_GIT:-} ]]; then
  source=("omarchy::git+file://${COO_OMARCHY_GIT}#commit=${_commit}")
else
  source=("omarchy::git+https://github.com/basecamp/omarchy.git#commit=${_commit}")
fi
sha256sums=('SKIP')

package() {
  # NOTE (chroot limitation, tracked for Milestone 7): overlay/defaults lives
  # two levels above this PKGBUILD, outside packages/cachy-omarchy-shell/. A
  # clean chroot build (makechrootpkg/archbuild) only bind-mounts the
  # PKGBUILD's own directory into the build root, so this path will not
  # resolve there. SPEC §26 permits plain `makepkg` for v0.1 and defers
  # chroot support to release quality, so this is accepted for now rather
  # than duplicating overlay/defaults/shell.json into this package directory
  # (which would create two sources of truth for the same file).
  bash "$startdir/stage-upstream.sh" "$srcdir/omarchy" "$pkgdir" \
    "$startdir/../../overlay/defaults"
}
