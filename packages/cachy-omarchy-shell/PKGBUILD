# Maintainer: Cachy Omarchy Overlay
pkgname=cachy-omarchy-shell
pkgver=4.0.0
pkgrel=5
pkgdesc='Pinned Omarchy Quattro shell runtime for CachyOS (no omarchy-settings)'
arch=('any')
url='https://github.com/basecamp/omarchy'
license=('MIT')
# libvips: omarchy-menu-images vipsthumbnail (theme/bg picker 미리보기 — 없으면
#   썸네일 부재가 조용하다). procps-ng: pgrep/pkill (restart-btop/helix,
#   theme-set-foot, cachy-omarchy-shell --run 중복 기동 검사). psmisc: killall
#   (restart-terminal 의 kitty/ghostty, restart-opencode). (M9, 설계 문서 D8)
# jq (M10 승격): clipboard history/read/write, reminders timer JSON, OSD payload —
#   더 이상 theme-hook 전용이 아니다. wl-clipboard: clipboard watcher(wl-paste)
#   ·copy(wl-copy). wtype: emoji/clipboard 선택 paste. wireplumber: wpctl
#   (mic mute). pipewire-pulse: pactl (output volume). xdg-utils:
#   xdg-settings/xdg-mime/xdg-terminal-exec (clipboard-open 의 launch closure).
depends=('quickshell' 'hyprland' 'inotify-tools' 'libvips' 'procps-ng' 'psmisc'
         'jq' 'wl-clipboard' 'wtype' 'wireplumber' 'pipewire-pulse' 'xdg-utils')
makedepends=('git')
optdepends=(
  'tmux: omarchy-theme-set-tmux hook'
  'foot: omarchy-theme-set-foot hook (OSC reload)'
)
_commit='f0020448ca87329199de7cb12f2015ebc4a3e5e7'

# bin/build-packages --clean creates these source archives only in a temporary
# makechrootpkg context. They keep the repository overlay as the single
# tracked source of truth while making every package input available inside
# the bind-mounted PKGBUILD directory.
if [[ -f $startdir/clean-omarchy.tar && -f $startdir/clean-overlay-defaults.tar ]]; then
  source=('clean-omarchy.tar' 'clean-overlay-defaults.tar')
  sha256sums=('SKIP' 'SKIP')
  _clean_context=1
elif [[ -n ${COO_OMARCHY_GIT:-} ]]; then
  source=("omarchy::git+file://${COO_OMARCHY_GIT}#commit=${_commit}")
  sha256sums=('SKIP')
  _clean_context=0
else
  source=("omarchy::git+https://github.com/basecamp/omarchy.git#commit=${_commit}")
  sha256sums=('SKIP')
  _clean_context=0
fi

package() {
  if (( _clean_context )); then
    bash "$startdir/stage-upstream.sh" "$srcdir/omarchy" "$pkgdir" \
      "$srcdir/overlay/defaults"
  else
    # The direct makepkg fallback retains the repository layout for developers.
    # A clean chroot cannot see this parent path; use bin/build-packages --clean
    # rather than copying overlay/defaults into this tracked package directory.
    bash "$startdir/stage-upstream.sh" "$srcdir/omarchy" "$pkgdir" \
      "$startdir/../../overlay/defaults"
  fi
}
