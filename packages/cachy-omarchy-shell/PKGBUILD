# Maintainer: Cachy Omarchy Overlay
pkgname=cachy-omarchy-shell
pkgver=4.0.0
pkgrel=22
pkgdesc='Pinned Omarchy Quattro shell runtime for CachyOS (no omarchy-settings)'
arch=('any')
url='https://github.com/basecamp/omarchy'
license=('MIT')
# libvips: omarchy-menu-images vipsthumbnail (theme/bg picker 미리보기 — 없으면
#   썸네일 부재가 조용하다). procps-ng: pgrep/pkill (restart-btop/helix,
#   theme-set-foot, cachy-omarchy-shell --run 중복 기동 검사). psmisc: killall
#   (restart-terminal 의 kitty/ghostty, restart-opencode). (M9, 설계 문서 D8)
# jq (M10 승격): clipboard history/read/write, reminders timer JSON, OSD payload —
#   더 이상 theme-hook 전용이 아니다. wl-clipboard: clipboard watcher(wl-paste)
#   ·copy(wl-copy). wtype: emoji/clipboard 선택 paste. wireplumber: wpctl
#   (mic mute). pipewire-pulse는 pactl 을 스스로 제공하지 않는다 — pactl 의
#   실소유 패키지는 libpulse 다(pacman -Qqo 실측, 아래 v0.9 블록 참고). xdg-utils:
#   xdg-settings/xdg-mime (clipboard-open 의 launch closure). xdg-terminal-exec
#   는 xdg-utils 가 제공한다던 이전 주석은 오류였다 — 별도 AUR 패키지이며
#   optdepends 에서 AUR class 로 따로 선언한다(pacman -Ql 실측, 컨트롤러 룰링;
#   fix round 1 에서 depends 에서 optdepends 로 재배치 — 아래 참고).
# uwsm: AppLibrary.qml:85 등이 uwsm-app 을 bare name 으로 부른다. 업스트림도
#   uwsm 세션을 전제한다 (AGENTS.md:53). /usr/bin/uwsm-app 은 uwsm 패키지가
#   제공하며 우리는 shim 을 두지 않는다.
# v0.9 클로저 스캐너 실측으로 승격(tests/data/command-packages.tsv 근거, 10건):
#   gum·git: 테마 install/update 경로(Theme > Install 메뉴) — git 은
#     makedepends 에도 남는다(PKGBUILD source 가 git+https 다). perl:
#     omarchy-menu-select 가 -MEncode -MJSON::PP 로 select payload 를 만드는
#     키바인딩 UI 경로. hyprsunset: omarchy.nightlight 플러그인이 기본
#     활성이고 Service.qml 이 uwsm-app -- hyprsunset 으로 데몬을 직접 띄운다.
#   grim·slurp: 스크린샷 캡처/영역 선택 메뉴 행의 구동 기계 — 이 둘 없이는
#     그 메뉴 행 자체가 동작하지 못한다(§4.2 개정).
#   libnotify: omarchy-notification-send 폴백 경로(notify-send). libpulse:
#     pactl 의 실소유 패키지(위 참고) — pipewire-pulse 만으로는 부족했다.
#   sudo: cachy-omarchy-init 이 락스크린 PAM 서비스 설정을
#     omarchy-apply-lock 에 위임하며 그것이 root 를 요구한다 — 메뉴 행이
#     아니라 우리 자신의 설치 경로에서 도달한다(컨트롤러 룰링).
#   which: Tailscale 패널의 존재 확인 구동 기계 — 패널 자체가 이 명령 없이는
#     상태를 못 읽는다(.command= 경로에서 신규 발견).
#   (xdg-terminal-exec 도 §4.2 성격의 구동 기계지만 리포엔 없고 AUR 전용이라
#     depends 에 못 둔다 — fix round 1 에서 optdepends AUR class 로 재배치.
#     아래 optdepends 블록 참고.)
#   upower (v0.10.0): omarchy-battery-status 의 구동 기계 — Power 패널이
#     Panel.qml:210 에서 무조건 호출(docs/CLOSURE_PRIORITY.md).
# v0.12.1 정책 전환: 아래 두 번째 블록 16개는 v0.12.0 까지 optdepends 였다.
#   분류(tests/data/command-packages.tsv 의 OPT)는 "기본 활성 경로에서 도달하지
#   않는다"는 도달성 사실이고 그건 그대로다 — 바뀐 것은 선언 정책이다. 이
#   오버레이는 큐레이팅된 데스크톱을 출하하며, 메뉴·패널 항목이 설치 직후
#   동작하지 않는 상태를 기본값으로 두지 않는다. 클로저 스캐너는 OPT 를
#   depends·optdepends 어느 쪽으로도 만족시킬 수 있다(closure_check.py:1074).
#   AUR class(xdg-terminal-exec/ttfx/dropbox-cli/tensaku)는 여전히 depends 에
#   둘 수 없다 — pacman -U 가 리포/설치된 패키지로만 해결한다(bin/install-packages).
depends=('quickshell' 'hyprland' 'uwsm' 'inotify-tools' 'libvips' 'procps-ng'
         'psmisc' 'jq' 'wl-clipboard' 'wtype' 'wireplumber' 'pipewire-pulse'
         'xdg-utils' 'git' 'grim' 'gum' 'hyprsunset' 'libnotify' 'libpulse'
         'perl' 'slurp' 'sudo' 'upower' 'which'
         # 테마 훅·하드웨어 제어·메뉴/패널 대상 — v0.12.1 에서 optdepends 에서 승격.
         # 배열 안 주석에 괄호를 쓰지 않는다: 테스트가 sed 범위로 배열을 뜨는데
         # 닫는 괄호 한 글자가 추출을 조용히 잘라먹는다.
         'tmux' 'foot' 'brightnessctl' 'ddcutil' 'lsp-plugins-lv2' 'socat'
         'bluez-utils' 'desktop-file-utils' 'gtk-update-icon-cache' 'hyprpicker'
         'iw' 'mpv' 'networkmanager' 'pacman-contrib' 'power-profiles-daemon'
         'usbutils')
# /usr/bin/omarchy-* 를 공식 omarchy 패키지와 같은 이름으로 소유한다. 상호
# 배타가 의도다. provides 는 하지 않는다 — Omarchy 전체를 제공하지 않는다.
conflicts=('omarchy')
makedepends=('git')
optdepends=(
  # v0.9 클로저 스캐너 실측으로 신규 선언(tests/data/command-packages.tsv 근거,
  # 18건). 메뉴/패널 항목이며 기본 경로에서 도달하지 않는다 — 사용자가 그
  # 기능을 씀으로써 선택한다.
  #
  # asdcontrol(Apple Studio Display 밝기, omarchy-brightness-display-apple)는
  # 여기 없다 — AUR RPC info/search 둘 다 0건(fix round 1 실측), 공식 리포에도
  # AUR 에도 제공자가 없는 UNPACKAGED 다. 어디에도 선언할 수 없다; 없으면 그
  # 헬퍼 하나만 조용히 동작하지 않는다(tests/data/command-packages.tsv 참고).
  #
  # 아래 AUR class 4건은 리포엔 없고 AUR 에만 존재한다(각 AUR RPC info 로 실측,
  # fix round 1). pacman -U 는 depends 를 리포/설치된 패키지로만 해결하므로
  # (bin/install-packages:55) depends 에 넣으면 우리 패키지 자체가 설치
  # 불가해진다 — 그래서 HARD 성격이라도 optdepends 에 둔다:
  'xdg-terminal-exec: AUR — 터미널 실행의 구동 기계, omarchy-launch-tui/omarchy-launch-terminal/omarchy-launch-floating-terminal-with-presentation 전부 이것 없이는 실패(HARD 성격이나 리포에 없어 depends 불가)'
  # ttfx 는 리포 무결과(pacman -Ss ttfx 0건, 2026-08-23 실측) — AUR 전용이라
  # xdg-terminal-exec 과 같은 이유로 depends 에 둘 수 없다. 부재는 crash 가
  # 아니다: omarchy-launch-screensaver 첫 줄의 omarchy-cmd-missing 가드가
  # exit 1 로 흡수한다.
  'ttfx: AUR — 스크린세이버 효과 렌더러(omarchy-screensaver 본체). 없으면 스크린세이버만 조용히 뜨지 않는다'
  'discord: Discord 커뮤니티 실행 메뉴 항목'
  'dropbox-cli: AUR — Dropbox 패널 대상 애플리케이션'
  'ffmpeg: 화면 녹화 인코딩'
  'gpu-screen-recorder: 화면 녹화 메뉴 항목'
  # v0.12.0 Track B: 바 투명 모드 텍스트 대비색(omarchy-bar-text-color).
  # 부재 시 헬퍼가 테마 전경색으로 폴백한다.
  'imagemagick: omarchy-bar-text-color 의 배경 대비 계산(투명 바 텍스트색). 부재 시 헬퍼가 테마 전경색으로 폴백한다'
  'python: Dropbox 패널의 번들 상태 스크립트(status.py) 실행기'
  'tailscale: Tailscale 패널 대상 애플리케이션'
  'tensaku: AUR — 클립보드/스크린샷 편집기 기본값, 폴백 없음(바이너리명 tensaku-edit 는 패키지명이 아니다 — 실제 AUR 패키지는 tensaku)'
  'tesseract: OCR 메뉴 항목'
  'v4l-utils: 웹캠/캡처 장치 진단 메뉴 항목'
  'zbar: QR/바코드 스캔 메뉴 항목'
)
_commit='f0020448ca87329199de7cb12f2015ebc4a3e5e7'

# bin/build-packages --clean creates these source archives only in a temporary
# makechrootpkg context. They keep the repository overlay as the single
# tracked source of truth while making every package input available inside
# the bind-mounted PKGBUILD directory.
if [[ -f $startdir/clean-omarchy.tar && -f $startdir/clean-overlay-defaults.tar ]]; then
  source=('clean-omarchy.tar' 'clean-overlay-defaults.tar')
  sha256sums=('SKIP' 'SKIP')
  _clean_context=1
elif [[ -n ${COO_OMARCHY_GIT:-} ]]; then
  source=("omarchy::git+file://${COO_OMARCHY_GIT}#commit=${_commit}")
  sha256sums=('SKIP')
  _clean_context=0
else
  source=("omarchy::git+https://github.com/basecamp/omarchy.git#commit=${_commit}")
  sha256sums=('SKIP')
  _clean_context=0
fi

# Maintained runtime patches (patches/README.md) must be applied to the source
# makepkg actually stages. `bin/update-upstream` patches its candidate's *working
# tree*, but every build path here clones the pinned `#commit=` object into
# $srcdir — a working-tree patch never survives that clone. Applying them here
# is the only point both the direct makepkg path and the clean-chroot path pass
# through, so this is where the patch contract becomes real in the artifact.
#
# Lexicographic order, matching what patches/README.md promises. A failure is
# fatal: a silently unpatched package is exactly the regression
# tests/runtime/test_reload_watcher_reap.sh exists to catch.
prepare() {
  local patch
  for patch in "$startdir"/patches/*.patch; do
    [[ -f $patch ]] || continue
    msg2 "applying maintained runtime patch: ${patch##*/}"
    git -C "$srcdir/omarchy" apply "$patch"
  done
}

package() {
  if (( _clean_context )); then
    bash "$startdir/stage-upstream.sh" "$srcdir/omarchy" "$pkgdir" \
      "$srcdir/overlay/defaults"
  else
    # The direct makepkg fallback retains the repository layout for developers.
    # A clean chroot cannot see this parent path; use bin/build-packages --clean
    # rather than copying overlay/defaults into this tracked package directory.
    bash "$startdir/stage-upstream.sh" "$srcdir/omarchy" "$pkgdir" \
      "$startdir/../../overlay/defaults"
  fi
}
