# Maintainer: Cachy Omarchy Overlay
pkgname=cachy-omarchy-overlay
pkgver=0.12.1
pkgrel=2
pkgdesc='CachyOS integration for the pinned Omarchy Quattro shell runtime'
arch=('any')
url='https://github.com/basecamp/omarchy'
license=('MIT')
# 업스트림 버전과 독립적으로 진화한다 (SPEC 6.4, 8). 공식 omarchy /
# omarchy-settings 에는 절대 의존하지 않는다 (SPEC 21).
depends=('cachy-omarchy-shell' 'bash')

# /usr/bin/omarchy-* 를 공식 omarchy 패키지와 같은 이름으로 소유한다 (compat
# 적응 카피 6개). 상호 배타가 의도다. provides 는 하지 않는다.
conflicts=('omarchy')

# bin/build-packages --clean creates this source archive only in its temporary
# context. No overlay copy is tracked under packages/, so overlay/ remains the
# single source of truth for normal and clean builds alike.
if [[ -f $startdir/clean-overlay.tar ]]; then
  source=('clean-overlay.tar')
  sha256sums=('SKIP')
  _clean_context=1
else
  source=()
  sha256sums=()
  _clean_context=0
fi

package() {
  if (( _clean_context )); then
    bash "$startdir/stage-overlay.sh" "$srcdir/overlay" "$pkgdir"
  else
    # Direct makepkg keeps the developer repository layout. A clean chroot
    # must use the temporary source archive produced by build-packages --clean.
    bash "$startdir/stage-overlay.sh" "$startdir/../../overlay" "$pkgdir"
  fi
}
